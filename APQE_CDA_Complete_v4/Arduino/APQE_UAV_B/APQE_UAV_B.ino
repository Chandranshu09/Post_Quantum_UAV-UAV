#include <ApqeCdaAll.h>

using namespace apqe;

/* EDIT THESE THREE VALUES. UAV_B does not need UAV_A's IP. */
static const char* WIFI_SSID = "YOUR_WIFI_SSID";
static const char* WIFI_PASSWORD = "YOUR_WIFI_PASSWORD";
static const IPAddress LAPTOP_IP(192, 168, 29, 100);

static NodeConfig makeConfig()
{
    NodeConfig c{};
    c.role = Role::Responder;
    c.wifiSsid = WIFI_SSID;
    c.wifiPassword = WIFI_PASSWORD;
    c.gatewayIp = LAPTOP_IP;
    c.gatewayPort = GATEWAY_ORG2_PORT;
    c.gatewayLocalPort = 5232;
    c.responderIp = IPAddress(0, 0, 0, 0);
    c.protocolPort = PROTOCOL_PORT;
    c.numberOfSessions = DEFAULT_SESSION_COUNT;

    memset(c.deviceId, 0x42, sizeof(c.deviceId));
    memset(c.peerId, 0x41, sizeof(c.peerId));

    const uint8_t raw[HASH_BYTES] = {
        0x8c,0x25,0xd7,0x41,0x0e,0xb9,0x63,0xf2,
        0x54,0xaa,0x17,0xcd,0x38,0x70,0x96,0x2b,
        0xe1,0x4f,0x85,0x09,0xbc,0x32,0x6d,0xf8,
        0x13,0x59,0xa0,0x77,0xc4,0x2e,0x91,0x5b
    };
    const uint8_t helper[HASH_BYTES] = {
        0x29,0x6f,0xb2,0x04,0xdc,0x83,0x51,0xae,
        0x74,0x18,0xc9,0x35,0x90,0xe6,0x42,0x0b,
        0xf5,0x67,0x1d,0xba,0x88,0x23,0xd0,0x5c,
        0x99,0x46,0xef,0x12,0x7a,0x31,0xa4,0xc8
    };
    const uint8_t bs[HASH_BYTES] = {
        0xd2,0x47,0x0f,0x91,0x5a,0xe8,0x36,0xbc,
        0x21,0x6d,0xf3,0x08,0x84,0xca,0x59,0x17,
        0xee,0x32,0x75,0xa9,0x40,0x1c,0xd6,0x8b,
        0x53,0xfa,0x24,0x69,0xb0,0x3e,0x97,0x0d
    };
    memcpy(c.emulatedSramRaw, raw, HASH_BYTES);
    memcpy(c.emulatedSramHelper, helper, HASH_BYTES);
    memcpy(c.emulatedBsPufSecret, bs, HASH_BYTES);
    return c;
}

static ApqeProtocol protocol(makeConfig());

void setup()
{
    Serial.begin(115200);
    delay(1200);
    if (!protocol.begin()) {
        Serial.println("UAV_B initialization failed.");
    }
}

void loop()
{
    protocol.loop();
}
