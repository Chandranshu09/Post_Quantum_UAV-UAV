#include <ApqeCdaAll.h>

using namespace apqe;

/* EDIT THESE FOUR VALUES. */
static const char* WIFI_SSID = "YOUR_WIFI_SSID";
static const char* WIFI_PASSWORD = "YOUR_WIFI_PASSWORD";
static const IPAddress LAPTOP_IP(192, 168, 29, 100);
static const IPAddress UAV_B_IP(192, 168, 29, 98);

static NodeConfig makeConfig()
{
    NodeConfig c{};
    c.role = Role::Initiator;
    c.wifiSsid = WIFI_SSID;
    c.wifiPassword = WIFI_PASSWORD;
    c.gatewayIp = LAPTOP_IP;
    c.gatewayPort = GATEWAY_ORG1_PORT;
    c.gatewayLocalPort = 5231;
    c.responderIp = UAV_B_IP;
    c.protocolPort = PROTOCOL_PORT;
    c.numberOfSessions = DEFAULT_SESSION_COUNT;

    memset(c.deviceId, 0x41, sizeof(c.deviceId));
    memset(c.peerId, 0x42, sizeof(c.peerId));

    const uint8_t raw[HASH_BYTES] = {
        0x11,0x72,0xa4,0x0d,0x9b,0xc3,0x56,0xe8,
        0x39,0x65,0x1f,0xb0,0x7d,0x2a,0x94,0xce,
        0x48,0x83,0xd1,0x2f,0xfa,0x60,0x35,0x8c,
        0xb7,0x04,0xe2,0x99,0x5a,0x16,0x6d,0xc1
    };
    const uint8_t helper[HASH_BYTES] = {
        0xa5,0x3c,0x80,0x17,0xd9,0x4e,0x62,0xb1,
        0x08,0xf4,0x2d,0x96,0x71,0xcb,0x55,0x3a,
        0xe7,0x20,0x8a,0x6f,0x14,0xbd,0x43,0x90,
        0x2b,0x78,0xc6,0x05,0xf1,0x59,0xac,0x34
    };
    const uint8_t bs[HASH_BYTES] = {
        0x63,0x18,0xf0,0x4b,0x95,0x2e,0xc7,0x51,
        0xaa,0x36,0x0c,0xd4,0x7f,0x89,0x22,0xbe,
        0x47,0x9d,0x31,0xe5,0x68,0x13,0xfb,0x74,
        0x0a,0xc2,0x5d,0x87,0xb9,0x40,0x26,0xde
    };
    memcpy(c.emulatedSramRaw, raw, HASH_BYTES);
    memcpy(c.emulatedSramHelper, helper, HASH_BYTES);
    memcpy(c.emulatedBsPufSecret, bs, HASH_BYTES);
    return c;
}

static ApqeProtocol protocol(makeConfig());

void setup()
{
    Serial.begin(115200);
    delay(1200);
    if (!protocol.begin()) {
        Serial.println("UAV_A initialization failed.");
    }
}

void loop()
{
    protocol.loop();
}
